{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cloudflare-link-shortener",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-04",
	"compatibility_flags": ["nodejs_compat"],
	"placement": {
		"mode": "smart"
	},
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"workers_dev": false,
	"preview_urls": true,
	"route": {
		"pattern": "go.aitsys.dev", // replace with your domain
		"custom_domain": true,
		"zone_id": "e9e86e9cc4298b9666b01b5cd3795099"
	},
	"dev": {
		"enable_containers": false,
		"ip": "127.0.0.1",
		"port": 8787,
		"local_protocol": "http",
		"upstream_protocol": "https"
	},
	"account_id": "ba6a46b16b99f5f74858beafc22187c7",
	"keep_names": true,
	"keep_vars": true,
	"minify": true,
	"vars": {
		"SITE_NAME": "AITSYS Go",
		"BRAND_LOGO_URL": "/logo.png",
		"BRAND_LOGO_ALT": "Aiko IT Systems",
		"FAVICON_URL": "/favicon.png",
		"BRAND_COLOR": "#fc0fc0"
	},
	"kv_namespaces": [
		{
			"binding": "LINKS",
			"id": "54872d4a38e6486e8f6cc053364d6f64" // replace with your KV namespace ID
		}
	],
	"secrets_store_secrets": [
		{
			"binding": "LINK_SHORTENER_API_KEY",
			"secret_name": "LINK_SHORTENER_API_KEY",
			"store_id": "766810d8e2c04f1ca24dcc45253af39e" // replace with your secrets store ID
		}
	]
}
