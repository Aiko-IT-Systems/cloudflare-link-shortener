{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "cloudflare-link-shortener",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-04",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"placement": {
		"mode": "smart"
	},
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"upload_source_maps": true,
	"workers_dev": false,
	"preview_urls": false,
	"dev": {
		"enable_containers": false,
		"ip": "127.0.0.1",
		"port": 8787,
		"local_protocol": "http",
		"upstream_protocol": "https"
	},
	"keep_names": true,
	"keep_vars": true,
	"minify": true,
	"secrets": {
		"required": [
			"LINK_SHORTENER_API_KEY",
			"DISCORD_PUBLIC_KEY"
		]
	},
	"kv_namespaces": [
		{
			"binding": "LINKS"
		}
	]
}
