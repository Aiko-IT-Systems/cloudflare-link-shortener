{
  "manifest_version": 3,
  "name": "AITSYS Go",
  "description": "Create transparent AITSYS Go short links from the current page.",
  "version": "2.1.5",
  "action": {
    "default_title": "AITSYS Go",
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/aitsys-go-cat-link-16.png",
      "32": "icons/aitsys-go-cat-link-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "activeTab",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "aitsys-go@aitsys.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "browsingActivity"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "16": "icons/aitsys-go-cat-link-16.png",
    "32": "icons/aitsys-go-cat-link-32.png",
    "48": "icons/aitsys-go-cat-link-48.png",
    "128": "icons/aitsys-go-cat-link-128.png"
  }
}
