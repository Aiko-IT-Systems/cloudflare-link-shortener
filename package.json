{
	"name": "cloudflare-link-shortener",
	"description": "Transparent AITSYS link shortener on Cloudflare Workers",
	"version": "2.1.4",
	"author": {
		"name": "Lulalaby",
		"email": "aiko@aitsys.dev",
		"url": "https://aitsys.dev"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Aiko-IT-Systems/cloudflare-link-shortener"
	},
	"packageManager": "npm@12.0.2",
	"license": "Apache-2.0",
	"private": true,
	"scripts": {
		"deploy": "node scripts/deploy-worker.mjs",
		"worker:config": "node scripts/generate-worker-config.mjs",
		"dev": "node scripts/run-worker.mjs dev",
		"test": "vitest run && npm run test:worker-runtime",
		"test:worker-runtime": "vitest run --config vitest.workers.config.mts",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"cf-typegen": "node scripts/run-worker.mjs types --strict-vars false",
		"extensions:build:chrome": "vite build --config src/extensions/vite.config.ts --mode chrome",
		"extensions:build:edge": "vite build --config src/extensions/vite.config.ts --mode edge",
		"extensions:build:firefox": "vite build --config src/extensions/vite.config.ts --mode firefox",
		"extensions:build": "npm run extensions:build:chrome && npm run extensions:build:edge && npm run extensions:build:firefox",
		"extensions:check": "node scripts/check-extensions.mjs",
		"release:sync-version": "node scripts/sync-release-version.mjs",
		"release:check-version": "node scripts/sync-release-version.mjs --check",
		"release:play-notes": "node scripts/prepare-play-release-notes.mjs",
		"discord:register": "node scripts/register-discord-commands.mjs",
		"android:clean": "node scripts/clean-android.mjs"
	},
	"dependencies": {
		"hono": "4.13.5",
		"nanoid": "6.0.1",
		"zod": "4.5.4"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "1.1.3",
		"@types/node": "24.13.3",
		"typescript": "7.0.2",
		"vite": "8.2.2",
		"vitest": "4.1.11",
		"wrangler": "4.128.0"
	}
}
